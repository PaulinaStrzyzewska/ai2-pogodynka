{% extends 'base.html.twig' %}

{% block title %}Weather Forecast!{% endblock %}

{% block body %}
    <h1>Weather Forecast</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn btn-primary">Submit</button>
    {{ form_end(form) }}

    {% if weatherData is not null %}
        <h2>Data from Open-Meteo</h2>

        <table class="table">
            <thead>
            <tr>
                <th>Date</th>
                <th>Max Temperature (°C)</th>
                <th>Min Temperature (°C)</th>
                <th>Precipitation (mm)</th>
            </tr>
            </thead>
            <tbody>
            {% for date in weatherData.daily.time %}
                {% set i = loop.index0 %}
                <tr>
                    <td>{{ date }}</td>
                    <td>{{ weatherData.daily.temperature_2m_max[i] }}</td>
                    <td>{{ weatherData.daily.temperature_2m_min[i] }}</td>
                    <td>{{ weatherData.daily.precipitation_sum[i] }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
